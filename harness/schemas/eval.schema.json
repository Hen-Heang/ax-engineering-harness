{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Hen-Heang/ax-engineering-harness/schemas/eval/v1",
  "title": "EvalDefinition",
  "description": "AX Harness v1 evaluation. An eval assesses agent behavior on a task; an application test assesses software. A definition states what good behavior is and how it is scored. It contains no results, and defining one runs nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "status", "task", "expectedBehaviors", "forbiddenBehaviors", "requiredConcepts", "qualityRequirements", "scoring", "notes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/definitions/identifier" },
    "title": { "$ref": "#/definitions/line" },
    "status": { "enum": ["implemented", "experimental", "planned"] },
    "task": { "$ref": "#/definitions/text", "description": "The instruction given to the agent under evaluation." },
    "expectedBehaviors": { "$ref": "#/definitions/notes", "description": "Behavior that should be observed. Each must be checkable from the agent's output or diff." },
    "forbiddenBehaviors": { "$ref": "#/definitions/notes", "description": "Behavior that fails the eval outright, however good the rest is." },
    "requiredConcepts": { "$ref": "#/definitions/notes", "description": "Files, symbols, or concepts a correct response must engage with." },
    "qualityRequirements": { "$ref": "#/definitions/notes", "description": "Gate outcomes the resulting change must achieve." },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria", "passThreshold"],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "weight"],
            "properties": {
              "id": { "$ref": "#/definitions/identifier" },
              "title": { "$ref": "#/definitions/line" },
              "weight": { "type": "integer", "minimum": 1, "maximum": 100 }
            }
          }
        },
        "passThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Percentage of the available weight required to pass, before forbidden behavior is considered."
        }
      }
    },
    "notes": { "$ref": "#/definitions/notes" }
  },
  "definitions": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "line": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$" },
    "note": { "type": "string", "minLength": 1, "maxLength": 320, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$" },
    "notes": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/definitions/note" } }
  }
}
