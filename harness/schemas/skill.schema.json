{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Hen-Heang/ax-engineering-harness/schemas/skill/v1",
  "title": "SkillDefinition",
  "description": "AX Harness v1 skill. A skill is a reusable procedure, not a worker. Defining a skill does not execute it and does not grant the capabilities it lists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "status", "purpose", "prerequisites", "steps", "capabilities", "outputs", "verification", "escalation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/definitions/identifier" },
    "name": { "$ref": "#/definitions/line" },
    "status": { "enum": ["implemented", "experimental", "planned"] },
    "purpose": { "$ref": "#/definitions/text" },
    "prerequisites": { "$ref": "#/definitions/notes" },
    "steps": { "$ref": "#/definitions/notes", "description": "Ordered procedure. Order is meaningful." },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
      "description": "Capabilities this procedure needs. Every agent listing this skill must hold all of them."
    },
    "outputs": { "$ref": "#/definitions/notes" },
    "verification": { "$ref": "#/definitions/notes", "description": "How to tell the procedure was actually followed." },
    "escalation": { "$ref": "#/definitions/notes", "description": "When to stop and hand back to a human." }
  },
  "definitions": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "line": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$" },
    "note": { "type": "string", "minLength": 1, "maxLength": 320, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$" },
    "notes": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/definitions/note" } }
  }
}
